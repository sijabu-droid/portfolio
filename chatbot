<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Food Delivery AI Chatbot</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family: Arial, sans-serif;
    }

    body{
      background:#f4f4f4;
      display:flex;
      justify-content:center;
      align-items:center;
      height:100vh;
    }

    .chat-container{
      width:350px;
      background:#fff;
      border-radius:15px;
      overflow:hidden;
      box-shadow:0 4px 15px rgba(0,0,0,0.2);
    }

    .chat-header{
      background:#ff5722;
      color:white;
      padding:15px;
      text-align:center;
      font-size:20px;
      font-weight:bold;
    }

    .chat-box{
      height:400px;
      overflow-y:auto;
      padding:15px;
      display:flex;
      flex-direction:column;
      gap:10px;
      background:#fafafa;
    }

    .message{
      padding:10px 14px;
      border-radius:12px;
      max-width:80%;
      line-height:1.4;
    }

    .bot{
      background:#e0e0e0;
      align-self:flex-start;
    }

    .user{
      background:#ff5722;
      color:white;
      align-self:flex-end;
    }

    .chat-input{
      display:flex;
      border-top:1px solid #ddd;
    }

    .chat-input input{
      flex:1;
      padding:12px;
      border:none;
      outline:none;
      font-size:16px;
    }

    .chat-input button{
      background:#ff5722;
      color:white;
      border:none;
      padding:12px 18px;
      cursor:pointer;
      font-size:16px;
    }

    .chat-input button:hover{
      background:#e64a19;
    }
  </style>
</head>
<body>

  <div class="chat-container">
    
    <div class="chat-header">
      Food Delivery Assistant
    </div>

    <div class="chat-box" id="chatBox">
      <div class="message bot">
        Hello 👋 Welcome to FastBite Delivery! How can I help you today?
      </div>
    </div>

    <div class="chat-input">
      <input type="text" id="userInput" placeholder="Type a message..." />
      <button onclick="sendMessage()">Send</button>
    </div>

  </div>

  <script>
    function sendMessage() {
      const input = document.getElementById("userInput");
      const chatBox = document.getElementById("chatBox");

      const userText = input.value.trim();

      if(userText === "") return;

      // User message
      const userMessage = document.createElement("div");
      userMessage.classList.add("message", "user");
      userMessage.textContent = userText;
      chatBox.appendChild(userMessage);

      // Bot response
      const botMessage = document.createElement("div");
      botMessage.classList.add("message", "bot");

      let response = "";

      const text = userText.toLowerCase();

      if(text.includes("hello") || text.includes("hi")){
        response = "Hello! 😊 How can I assist you with your order?";
      }
      else if(text.includes("menu")){
        response = "Today's specials are Pizza 🍕, Burgers 🍔, and Sushi 🍣.";
      }
      else if(text.includes("track")){
        response = "Your order is currently on the way 🚗.";
      }
      else if(text.includes("delivery")){
        response = "Delivery usually takes 30-45 minutes.";
      }
      else if(text.includes("bye")){
        response = "Thank you for choosing FastBite! Have a great day 👋";
      }
      else{
        response = "I'm sorry, I didn't understand that. Please try again.";
      }

      setTimeout(() => {
        botMessage.textContent = response;
        chatBox.appendChild(botMessage);

        // Auto scroll
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 500);

      input.value = "";

      // Auto scroll
      chatBox.scrollTop = chatBox.scrollHeight;
    }

    // Enter key support
    document.getElementById("userInput")
      .addEventListener("keypress", function(event){
        if(event.key === "Enter"){
          sendMessage();
        }
      });
  </script>

</body>
</html>
